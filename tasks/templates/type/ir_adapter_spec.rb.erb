# frozen_string_literal: true

require "spec_helper"
require "etassia/notation/mermaid/ir_adapters/<%= type %>"

RSpec.describe Etassia::Notation::Mermaid::IRAdapters::<%= klass %> do
  it "maps ordered items to valid shared data with stable identities" do
    diagram = Etassia::Diagram::<%= klass %>.new(items: ["same", "same"])
    data = described_class.call(diagram)

    expect(
      [data.class, data.valid?, data.role,
       data.items.map { |item| [item.id, item.label, item.role] }],
    ).to eq(
      [Etassia::IR::Data, true, "ordered_list",
       [["<%= type %>_item_0", "same", "list_item"],
        ["<%= type %>_item_1", "same", "list_item"]]],
    )
  end
end
